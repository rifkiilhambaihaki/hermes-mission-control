{
  "name": "hermes-mission-control",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, read-only mission control dashboard for Hermes Agent — unified observations, operational monitoring, and extensible domain adapters.",
  "license": "MIT",
  "author": "Rifki Ilham Baihaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rifkiilhambaihaki/hermes-mission-control.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "node tools/lint-foundation.mjs",
    "test": "vitest run",
    "audit:publication": "node tools/audit-publication.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build:demo": "vite build --mode demo",
    "build": "npm run build:server && npm run build:web",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:demo",
    "demo": "vite --mode demo --host 127.0.0.1 --port 4174 --strictPort",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "start:local": "node dist/server/bootstrap/mission-control.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}

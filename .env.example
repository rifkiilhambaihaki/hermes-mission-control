# Placeholder-only example. This file is not loaded automatically by Node.
# Export reviewed values through your shell, service manager, or secret manager.

HMC_BASIC_USERNAME=mission-control
HMC_BASIC_PASSWORD_HASH=<generate-a-new-scrypt-v1-hash>
HMC_PORT=3200

HMC_HERMES_PROFILE_ROOT=/absolute/path/to/.hermes
HMC_HERMES_SITE_PACKAGES_ROOT=/absolute/path/to/python/site-packages
HMC_HERMES_DISTRIBUTION_METADATA_DIR=/absolute/path/to/hermes_agent.dist-info
HMC_HERMES_SOURCE_ROOT=/absolute/path/to/hermes-agent/source
HMC_SCHEMA_ROOT=/absolute/path/to/hermes-mission-control/schemas

HMC_ACCOUNTING_SNAPSHOT_PATH=/private/snapshots/accounting_v2.snapshot.json
HMC_BANK_JOURNAL_SNAPSHOT_PATH=/private/snapshots/bank_journal_quality.snapshot.json
HMC_SUBMISSION_SNAPSHOT_PATH=/private/snapshots/submission_tracker.snapshot.json

# Optional testing override. Leave unset in normal operation.
# HMC_PROC_ROOT=/proc
